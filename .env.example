# Copy only the public Web configuration names from Firebase Console into .env.local.
# Never put service-account credentials, a Gemini server API key or an App Check
# debug token in VITE_* variables: Vite makes these values available to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public production App Check reCAPTCHA Enterprise site key (not a debug token).
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# For local development only, set the following non-secret flag in
# .env.development.local; it is ignored outside DEV on loopback hostnames.
# VITE_FIREBASE_APP_CHECK_DEBUG=true
